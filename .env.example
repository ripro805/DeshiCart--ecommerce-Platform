# DeshiCart backend - environment variables template
# Copy to .env for local dev:   cp .env.example .env
# Production values are set in Render Dashboard - Environment (do NOT put them here).
# Lines starting with # are comments. Empty values fall back to the dev defaults in deshicart/settings.py.

# === Runtime mode ===
# When false, settings.py refuses to start unless DJANGO_SECRET_KEY is set.
# Set to "true" for local SQLite work; "false" for production.
DJANGO_DEBUG=true

# Generate with:   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated. Add your Render hostname in production:
#   deshicart-ecommerce-platform.onrender.com,api.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# === Database ===
# Set USE_NEON=true to switch from SQLite to Neon PostgreSQL.
# For local dev, leave USE_NEON=false (uses db.sqlite3).
USE_NEON=false

# Connection string from Neon dashboard - Connection Details - Pooled.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Required when USE_NEON=true.
DATABASE_URL=

# === SSLCommerz payment gateway ===
# Live creds from your SSLCommerz merchant dashboard (https://merchant.sslcommerz.com/).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=

# "true" for sandbox testing, "false" for production.
SSLCOMMERZ_IS_SANDBOX=true

# Public origin that SSLCommerz redirects/IPN-posts back to. No trailing slash.
# Local dev:  http://localhost:8000
# Production: https://deshicart-ecommerce-platform.onrender.com
SSLCOMMERZ_BACKEND_URL=http://localhost:8000

# === Render.com tuning (optional) ===
# WEB_CONCURRENCY=2
# PYTHONUNBUFFERED=true
# --- Email (Gmail SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True

# --- Frontend URL ---
FRONTEND_DOMAIN=localhost:3000
FRONTEND_PROTOCOL=http

# --- SSLCommerz gateway URLs ---
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/checkout/success
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/checkout/cancel
SSLCOMMERZ_FAIL_URL=http://localhost:3000/checkout/fail
SSLCOMMERZ_IPN_URL=http://localhost:8000/api/orders/sslcommerz/ipn/

