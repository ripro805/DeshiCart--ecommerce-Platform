# DeshiCart frontend (Next.js) - environment variables template
# Copy to frontend/.env.local for local dev:   cp .env.example .env.local
# Production values are set in Render Dashboard - Environment (do NOT put them here).
#
# IMPORTANT: variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle
# at BUILD time. If you change a NEXT_PUBLIC_ value, you must rebuild, not just restart.

# === Backend API ===
# The Next.js dev server proxies /api/* to this URL (see next.config.mjs rewrites).
# Local dev:  http://127.0.0.1:8000
# Production: https://deshicart-ecommerce-platform.onrender.com   (no trailing slash!)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# === OAuth (optional) ===
# If you wire up Google sign-in via Djoser social auth, set the OAuth start URL.
# Leave blank if Google sign-in is disabled.
NEXT_PUBLIC_GOOGLE_OAUTH_URL=


# === Render.com (production) ===
# Override for the deployed backend. The free deshicart-ecommerce-platform.onrender.com is the
# API host Render will give us once the Blueprint is applied.
NEXT_PUBLIC_API_URL=
